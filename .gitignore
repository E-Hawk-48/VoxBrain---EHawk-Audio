# ---- Build output (huge, regenerated by CMake — never commit) ----
/build/
/build-*/
build_log.txt
diag.txt

# ---- Third-party downloads (the build script re-fetches these) ----
/ThirdParty/

# ---- Release archives / installers ----
*.zip
*.exe
*.pkg
*.dmg

# ---- Local update settings / downloads ----
/update-server/*.exe
/update-server/*.pkg

# ---- OS / editor junk ----
.DS_Store
Thumbs.db
*.user
*.suo
.vs/
.idea/
